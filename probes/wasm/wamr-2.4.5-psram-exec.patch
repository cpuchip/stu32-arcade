+++ b/build-scripts/esp-idf/wamr/CMakeLists.txt
@@ -87,7 +87,7 @@ endif ()
 
 idf_component_register(SRCS ${srcs}
                        INCLUDE_DIRS ${include_dirs}
-                       REQUIRES pthread lwip esp_timer
+                       REQUIRES pthread lwip esp_timer esp_mm esp_psram heap
                        KCONFIG ${CMAKE_CURRENT_LIST_DIR}/Kconfig)
 
 target_compile_options(${COMPONENT_LIB} PRIVATE "-Wno-format")
diff --git a/core/iwasm/aot/arch/aot_reloc_xtensa.c b/core/iwasm/aot/arch/aot_reloc_xtensa.c
index a866883..228584a 100644
--- a/core/iwasm/aot/arch/aot_reloc_xtensa.c
+++ b/core/iwasm/aot/arch/aot_reloc_xtensa.c
@@ -143,6 +143,8 @@ check_reloc_offset(uint32 target_section_size, uint64 reloc_offset,
 {
     if (!(reloc_offset < (uint64)target_section_size
           && reloc_offset + reloc_data_size <= (uint64)target_section_size)) {
+        os_printf("PROBE reloc: section size %u, offset %llu, data size %u\n", target_section_size,
+                  (unsigned long long)reloc_offset, reloc_data_size); /* arcade's probe instrument */
