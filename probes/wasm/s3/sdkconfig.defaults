# SPDX-License-Identifier: MIT
# ESP32-S3 at 240 MHz and -O2 as the firmware builds; console on the S3's USB-Serial/JTAG (the XIAO's
# only port, and the stand-in's flash port); octal PSRAM (the XIAO's 8 MB, Rev A's 8 MB); 8 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
# WAMR (only read by its build): the interpreter alone, no AOT, no libc layers, no threads
CONFIG_WAMR_ENABLE_AOT=n
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=n
CONFIG_WAMR_ENABLE_LIBC_WASI=n
CONFIG_WAMR_ENABLE_LIB_PTHREAD=n
