 [ "${FLASH:-1}" = 1 ] && "$ROOT/scripts/fetch-casim.sh"
 [ "${FLASH:-1}" = 1 ] && [ "$WASM" = 1 ] && "$ROOT/scripts/fetch-wamr.sh"
 docker run --rm -i -v "$ROOT:/project" -w /project \
