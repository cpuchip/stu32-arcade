@@ -22,7 +24,7 @@ if [ "${FLASH:-1}" = 1 ] && { [ "$ROOT/device/standin/sdkconfig.defaults" -nt "$
     { [ "$WASM" = 1 ] && [ "$ROOT/device/sdkconfig.wasm" -nt "$ROOT/device/standin/$B/sdkconfig" ]; }; }; then
     rm -f "$ROOT/device/standin/$B/sdkconfig"
