+# WAMR, pinned (STU_WASM)
+
+WebAssembly Micro Runtime, github.com/wasm-micro-runtime/wasm-micro-runtime, under Apache-2.0 WITH
+LLVM-exception (its LICENSE). It runs .wasm games as .aot built by our pinned wamrc (decision 67: Michael,
+"WAMR, and send the fix upstream too"); its costs are counted under decision 68. Only with `STU_WASM`
+on; off, nothing of it is built.
+
+`scripts/fetch-wamr.sh` exports `PIN`'s commit from a local clone and applies `patches/` in order, checking
+each patch's sha256 and the resulting tree against `PIN`. The patches are modifications of WAMR, under its
+licence:
+
+1. `0001` maps PSRAM AOT code on the instruction bus (upstream PR #5146; issue #5145).
+2. `0002` fixes the Xtensa L32R relocation lost to strict aliasing (upstream PR #5148; issue #5147).
+3. `0003` makes `os_self_thread()` return the FreeRTOS task handle, so apps on the calc task can call
+   AOT code (local; soroban's ruling #5413). Its audit and the chip proof are in stu32-arcade
+   `probes/wasm/wamr-local-os-self-thread.patch`.
+4. `0004` makes every architecture's target symbol map const, so it sits in flash, not internal DRAM (local,
+   decision 68: with it and `WAMR_BUILD_QUICK_AOT_ENTRY=0` the option costs the stand-in 324 B of static
+   D/IRAM, not 2,100, and the stand-in boots). Audit: stu32-arcade `probes/wasm/wamr-local-const-symbol-map.patch`.
+5. `0005` lets a project without libc-wasi leave lwip out (local, decision 68): the device builds set
+   `WAMR_NO_LWIP`, so the option brings no VFS or console drivers, and Rev A with the option on and no game
+   is main's size. Audit: stu32-arcade `probes/wasm/wamr-local-no-lwip.patch`.
+
+Repin: move `commit`, drop each patch upstream has merged, regenerate the rest on the new commit, and
+record their sha256s and the new `git write-tree` in `PIN`; then measure the decision 68 table again.
diff --git a/third_party/wamr/patches/0001-esp-idf-map-PSRAM-AOT-code-on-the-instruction-bus.patch b/third_party/wamr/patches/0001-esp-idf-map-PSRAM-AOT-code-on-the-instruction-bus.patch
new file mode 100644
index 0000000..ca74aad
--- /dev/null
+++ b/third_party/wamr/patches/0001-esp-idf-map-PSRAM-AOT-code-on-the-instruction-bus.patch
@@ -0,0 +1,214 @@
+From 0207506ec8bf83d0592513812385be9704e33ab0 Mon Sep 17 00:00:00 2001
+From: Michael Stufflebeam <cpuchip@gmail.com>
+Date: Fri, 9 Oct 2026 13:36:14 +0000
+Subject: [PATCH 1/3] esp-idf: map PSRAM AOT code on the instruction bus
+
+On ESP32-S3 with PSRAM, WASM_MEM_DUAL_BUS_MIRROR put AOT code in PSRAM
+and returned its data bus address plus SOC_IROM_LOW - SOC_IROM_HIGH as
+the code address. That is not instruction memory, so the first call
+into an AOT module panicked with IllegalInstruction.
+
+Map the block's physical pages on the instruction bus with
+esp_mmu_map() instead, return that address from os_mmap(), and return
+the block's data bus address from os_get_dbus_mirror() so the loader
+copies and relocates the code there. os_munmap() unmaps and frees it.
+The wamr component now requires esp_mm for esp_mmu_map.h.
+
+Co-Authored-By: Claude <noreply@anthropic.com>
+---
+ build-scripts/esp-idf/wamr/CMakeLists.txt    |   2 +-
+ core/shared/platform/esp-idf/espidf_memmap.c | 132 ++++++++++++++++---
+ 2 files changed, 116 insertions(+), 18 deletions(-)
+
+diff --git a/build-scripts/esp-idf/wamr/CMakeLists.txt b/build-scripts/esp-idf/wamr/CMakeLists.txt
+index c5662f2..f89e075 100644
+--- a/build-scripts/esp-idf/wamr/CMakeLists.txt
++++ b/build-scripts/esp-idf/wamr/CMakeLists.txt
+@@ -91,7 +91,7 @@ endif ()
+ 
+ idf_component_register(SRCS ${srcs}
+                        INCLUDE_DIRS ${include_dirs}
+-                       REQUIRES pthread lwip esp_timer
++                       REQUIRES pthread lwip esp_timer esp_mm
+                        KCONFIG ${CMAKE_CURRENT_LIST_DIR}/Kconfig)
+ 
+ # ESP-IDF enables -Wformat-security by default.  It must be disabled together
+diff --git a/core/shared/platform/esp-idf/espidf_memmap.c b/core/shared/platform/esp-idf/espidf_memmap.c
+index 23b23d1..027a645 100644
+--- a/core/shared/platform/esp-idf/espidf_memmap.c
++++ b/core/shared/platform/esp-idf/espidf_memmap.c
+@@ -8,13 +8,109 @@
+ #if (WASM_MEM_DUAL_BUS_MIRROR != 0)
+ #include "soc/mmu.h"
+ #include "rom/cache.h"
++#include "esp_mmu_map.h"
+ 
+-#define MEM_DUAL_BUS_OFFSET (SOC_IROM_LOW - SOC_IROM_HIGH)
++static portMUX_TYPE s_spinlock = portMUX_INITIALIZER_UNLOCKED;
+ 
+-#define in_ibus_ext(addr) \
+-    (((uint32)addr >= SOC_IROM_LOW) && ((uint32)addr < SOC_IROM_HIGH))
++/* Heap memory in PSRAM is mapped on the data bus only. To run AOT code from
++ * PSRAM, map the same physical pages on the instruction bus too. The code is
++ * written through the data bus address (os_get_dbus_mirror) and run through
++ * the instruction bus address that os_mmap returns. */
++#define EXEC_MAP_MAX 8
+ 
+-static portMUX_TYPE s_spinlock = portMUX_INITIALIZER_UNLOCKED;
++typedef struct ExecMap {
++    uint8 *ibus;
++    uint8 *dbus;
++    size_t size;
++} ExecMap;
++
++static ExecMap exec_maps[EXEC_MAP_MAX];
++
++static void *
++exec_mmap(size_t size)
++{
++    size_t page = CONFIG_MMU_PAGE_SIZE;
++    size_t map_size = (size + page - 1) & ~(page - 1);
++    esp_paddr_t paddr;
++    mmu_target_t target;
++    void *ibus = NULL;
++    uint8 *dbus;
++    esp_err_t err;
++    int i;
++
++    dbus = heap_caps_aligned_alloc(page, map_size, MALLOC_CAP_SPIRAM);
++    if (!dbus) {
++        os_printf("os_mmap: failed to allocate %u bytes of PSRAM for AOT "
++                  "code\n",
++                  (uint32)map_size);
++        return NULL;
++    }
++
++    err = esp_mmu_vaddr_to_paddr(dbus, &paddr, &target);
++    if (err != ESP_OK) {
++        os_printf("os_mmap: esp_mmu_vaddr_to_paddr failed: %s\n",
++                  esp_err_to_name(err));
++        heap_caps_free(dbus);
++        return NULL;
++    }
++
++    err = esp_mmu_map(paddr, map_size, target,
++                      MMU_MEM_CAP_EXEC | MMU_MEM_CAP_READ | MMU_MEM_CAP_32BIT,
++                      ESP_MMU_MMAP_FLAG_PADDR_SHARED, &ibus);
++    if (err != ESP_OK) {
++        os_printf("os_mmap: esp_mmu_map of %u bytes for AOT code failed: "
++                  "%s\n",
++                  (uint32)map_size, esp_err_to_name(err));
++        heap_caps_free(dbus);
++        return NULL;
++    }
++
++    portENTER_CRITICAL(&s_spinlock);
++    for (i = 0; i < EXEC_MAP_MAX; i++) {
++        if (!exec_maps[i].ibus) {
++            exec_maps[i].ibus = ibus;
++            exec_maps[i].dbus = dbus;
++            exec_maps[i].size = map_size;
++            break;
++        }
++    }
++    portEXIT_CRITICAL(&s_spinlock);
++
++    if (i == EXEC_MAP_MAX) {
++        os_printf("os_mmap: more than %d AOT code blocks are mapped\n",
++                  EXEC_MAP_MAX);
++        esp_mmu_unmap(ibus);
++        heap_caps_free(dbus);
++        return NULL;
++    }
++
++    memset(dbus, 0, map_size);
++    return ibus;
++}
++
++static bool
++exec_munmap(void *ibus)
++{
++    uint8 *dbus = NULL;
++    int i;
++
++    portENTER_CRITICAL(&s_spinlock);
++    for (i = 0; i < EXEC_MAP_MAX; i++) {
++        if (exec_maps[i].ibus == ibus) {
++            dbus = exec_maps[i].dbus;
++            exec_maps[i].ibus = NULL;
++            break;
++        }
++    }
++    portEXIT_CRITICAL(&s_spinlock);
++
++    if (!dbus) {
++        return false;
++    }
++    esp_mmu_unmap(ibus);
++    heap_caps_free(dbus);
++    return true;
++}
+ #endif
+ 
+ void *
+@@ -22,10 +118,9 @@ os_mmap(void *hint, size_t size, int prot, int flags, os_file_handle file)
+ {
+     if (prot & MMAP_PROT_EXEC) {
+ #if (WASM_MEM_DUAL_BUS_MIRROR != 0)
+-        uint32_t mem_caps = MALLOC_CAP_SPIRAM;
++        return exec_mmap(size);
+ #else
+         uint32_t mem_caps = MALLOC_CAP_EXEC;
+-#endif
+ 
+         // Memory allocation with MALLOC_CAP_EXEC will return 4-byte aligned
+         // Reserve extra 4 byte to fixup alignment and size for the pointer to
+@@ -42,10 +137,6 @@ os_mmap(void *hint, size_t size, int prot, int flags, os_file_handle file)
+ 
+         uintptr_t *addr_field = buf_fixed - sizeof(uintptr_t);
+         *addr_field = (uintptr_t)buf_origin;
+-#if (WASM_MEM_DUAL_BUS_MIRROR != 0)
+-        memset(buf_fixed + MEM_DUAL_BUS_OFFSET, 0, size);
+-        return buf_fixed + MEM_DUAL_BUS_OFFSET;
+-#else
+         memset(buf_fixed, 0, size);
+         return buf_fixed;
+ #endif
+@@ -90,8 +181,8 @@ os_munmap(void *addr, size_t size)
+     char *ptr = (char *)addr;
+ 
+ #if (WASM_MEM_DUAL_BUS_MIRROR != 0)
+-    if (in_ibus_ext(ptr)) {
+-        ptr -= MEM_DUAL_BUS_OFFSET;
++    if (exec_munmap(ptr)) {
++        return;
+     }
+ #endif
+     // We don't need special handling of the executable allocations
+@@ -134,11 +225,18 @@ os_icache_flush(void *start, size_t len)
+ void *
+ os_get_dbus_mirror(void *ibus)
+ {
+-    if (in_ibus_ext(ibus)) {
+-        return (void *)((char *)ibus - MEM_DUAL_BUS_OFFSET);
+-    }
+-    else {
+-        return ibus;
++    void *dbus = ibus;
++    int i;
++
++    portENTER_CRITICAL(&s_spinlock);
++    for (i = 0; i < EXEC_MAP_MAX; i++) {
++        if (exec_maps[i].ibus && (uint8 *)ibus >= exec_maps[i].ibus
++            && (uint8 *)ibus < exec_maps[i].ibus + exec_maps[i].size) {
++            dbus = exec_maps[i].dbus + ((uint8 *)ibus - exec_maps[i].ibus);
++            break;
++        }
+     }
++    portEXIT_CRITICAL(&s_spinlock);
++    return dbus;
+ }
+ #endif
+-- 
+2.53.0
+
diff --git a/third_party/wamr/patches/0002-xtensa-fix-L32R-relocation-lost-to-strict-aliasing.patch b/third_party/wamr/patches/0002-xtensa-fix-L32R-relocation-lost-to-strict-aliasing.patch
new file mode 100644
index 0000000..402c27c
--- /dev/null
+++ b/third_party/wamr/patches/0002-xtensa-fix-L32R-relocation-lost-to-strict-aliasing.patch
@@ -0,0 +1,64 @@
+From 2782612c40ccf450f1624383f61e42be1360d28e Mon Sep 17 00:00:00 2001
+From: Michael Stufflebeam <cpuchip@gmail.com>
+Date: Fri, 9 Oct 2026 14:23:22 +0000
+Subject: [PATCH 2/3] xtensa: fix L32R relocation lost to strict aliasing
+
+put_imm16_to_addr() wrote the new L32R immediate into an int8 buffer
+through an int16 pointer and read the buffer back through an int32
+pointer. That breaks strict aliasing, and GCC at -O2 (ESP-IDF v5.4.2)
+removes the write-back whenever the immediate does not cross a word
+boundary, so those L32R instructions keep their unrelocated offset and
+load from the start of the function instead of the literal pool.
+
+Copy the immediate with memcpy into a uint32 array, and write the
+result back with 32-bit stores only, which instruction memory needs.
+
+Co-Authored-By: Claude <noreply@anthropic.com>
+---
+ core/iwasm/aot/arch/aot_reloc_xtensa.c | 30 +++++++++++---------------
+ 1 file changed, 13 insertions(+), 17 deletions(-)
+
+diff --git a/core/iwasm/aot/arch/aot_reloc_xtensa.c b/core/iwasm/aot/arch/aot_reloc_xtensa.c
+index a866883..625422f 100644
+--- a/core/iwasm/aot/arch/aot_reloc_xtensa.c
++++ b/core/iwasm/aot/arch/aot_reloc_xtensa.c
+@@ -159,23 +159,19 @@ check_reloc_offset(uint32 target_section_size, uint64 reloc_offset,
+ static void
+ put_imm16_to_addr(int16 imm16, int16 *addr)
+ {
+-    int8 bytes[8];
+-    int32 *addr_aligned1, *addr_aligned2;
+-
+-    addr_aligned1 = (int32 *)((intptr_t)addr & ~3);
+-
+-    if ((intptr_t)addr % 4 != 3) {
+-        *(int32 *)bytes = *addr_aligned1;
+-        *(int16 *)(bytes + ((intptr_t)addr % 4)) = imm16;
+-        *addr_aligned1 = *(int32 *)bytes;
+-    }
+-    else {
+-        addr_aligned2 = (int32 *)(((intptr_t)addr + 3) & ~3);
+-        *(int32 *)bytes = *addr_aligned1;
+-        *(int32 *)(bytes + 4) = *addr_aligned2;
+-        *(int16 *)(bytes + 3) = imm16;
+-        memcpy(addr_aligned1, bytes, 8);
+-    }
++    uint32 offset = (uint32)((uintptr_t)addr & 3);
++    uint32 *addr_aligned = (uint32 *)((uintptr_t)addr & ~(uintptr_t)3);
++    uint32 words[2];
++
++    /* memcpy keeps this free of strict-aliasing violations; instruction
++     * memory only takes 32-bit stores */
++    words[0] = addr_aligned[0];
++    if (offset == 3)
++        words[1] = addr_aligned[1];
++    memcpy((uint8 *)words + offset, &imm16, sizeof(imm16));
++    addr_aligned[0] = words[0];
++    if (offset == 3)
++        addr_aligned[1] = words[1];
+ }
+ 
+ static union {
+-- 
+2.53.0
+
diff --git a/third_party/wamr/patches/0003-esp-idf-os_self_thread-returns-the-FreeRTOS-task-han.patch b/third_party/wamr/patches/0003-esp-idf-os_self_thread-returns-the-FreeRTOS-task-han.patch
new file mode 100644
index 0000000..02311c8
--- /dev/null
+++ b/third_party/wamr/patches/0003-esp-idf-os_self_thread-returns-the-FreeRTOS-task-han.patch
@@ -0,0 +1,37 @@
+From a988dc1a2ef7aa1cee6515b0796f5f58f21fa152 Mon Sep 17 00:00:00 2001
+From: Michael Stufflebeam <cpuchip@gmail.com>
+Date: Fri, 9 Oct 2026 15:39:20 +0000
+Subject: [PATCH 3/3] esp-idf: os_self_thread returns the FreeRTOS task handle
+ (STU-32 local)
+
+The STU-32 firmware calls apps from a plain FreeRTOS task, where
+pthread_self() asserts. In the AOT-only build the handle is only stored in
+the exec env and printed by the logger; the embedder sets the native stack
+boundary itself (wasm_runtime_set_native_stack_boundary).
+
+Co-Authored-By: Claude <noreply@anthropic.com>
+---
+ core/shared/platform/esp-idf/espidf_thread.c | 7 ++++---
+ 1 file changed, 4 insertions(+), 3 deletions(-)
+
+diff --git a/core/shared/platform/esp-idf/espidf_thread.c b/core/shared/platform/esp-idf/espidf_thread.c
+index cb68df8..f7e622d 100644
+--- a/core/shared/platform/esp-idf/espidf_thread.c
++++ b/core/shared/platform/esp-idf/espidf_thread.c
+@@ -33,9 +33,10 @@ os_thread_wrapper(void *arg)
+ korp_tid
+ os_self_thread(void)
+ {
+-    /* only allowed if this is a thread, xTaskCreate is not enough look at
+-     * product_mini for how to use this*/
+-    return pthread_self();
++    /* The FreeRTOS task handle, so a plain task (not a pthread) can call into
